# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
ALLOWED_USER_IDS=your-telegram-user-id

# Database
DATABASE_URL=postgres://assistant:assistant@localhost:5432/assistant

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# App
LOG_LEVEL=info
LOG_DIR=logs
CONVERSATION_WINDOW=20
METRICS_ADDR=:9090

# RAG (Retrieval-Augmented Generation)
# Enable RAG for long-term memory via embeddings (default: false)
RAG_ENABLED=false

# Embedding model for RAG (default: nomic-embed-text)
EMBEDDING_MODEL=nomic-embed-text

# Number of messages to retrieve from history via RAG (default: 5)
RAG_RETRIEVED_COUNT=5

# Number of recent messages to include (default: 10)
RAG_RECENT_COUNT=10

# Minimum cosine similarity threshold for retrieval (default: 0.5, range: 0-1)
RAG_MIN_SIMILARITY=0.5

# Hybrid search weights (must sum to 1.0)
RAG_WEIGHT_SEMANTIC=0.5  # Semantic similarity weight
RAG_WEIGHT_KEYWORD=0.3   # Keyword matching weight
RAG_WEIGHT_RECENCY=0.2   # Recency boost weight

# Recency decay in days (default: 30)
RAG_RECENCY_DECAY_DAYS=30

# MCP (Model Context Protocol) Integration
# Enable MCP for external tool integrations (default: false)
MCP_ENABLED=false

# Google OAuth credentials file path (required if MCP_ENABLED=true)
# Get this from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_OAUTH_CREDENTIALS=

# Custom token storage path (optional, defaults to system config directory)
GOOGLE_CALENDAR_MCP_TOKEN_PATH=
